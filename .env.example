# Copy this file to ".env" and fill it in. ".env" is never committed.
# Lines starting with # are notes. See README.md for what each one does.

# Turns off try-out mode (hides the test mailbox and the demo owner). Needed online.
NODE_ENV=production

# The person who runs the board. Signing in with this email gives the owner's tools.
OWNER_EMAIL=you@yourdomain.com

# The board's own web address, used in links inside emails.
PUBLIC_URL=https://board.yourdomain.com

# Your email service (needed: sign-in codes are emails).
SMTP_URL=smtps://username:password@smtp.example.com:465
MAIL_FROM=Lemonaid <hello@yourdomain.com>

# Set to 1 when Lemonaid runs behind a reverse proxy (nginx, Caddy, Traefik...).
# TRUST_PROXY=1

# Optional
# PORT=3000
# DATA_DIR=./data
# ACCENT_COLOR="#0a7e5a"   (keep the quotes: in a .env file an unquoted # starts a note)

# Optional AI check: a key from https://console.anthropic.com, then switch it on in the Owner's room.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
